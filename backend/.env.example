# Where the backend finds the database. Copy this file to ".env" and fill in the
# password there; ".env" is not committed.
#
# The values below are the ones used when a line is left out, except the
# password, which has none.
PGHOST=localhost
# 5432 after a standard installation. The PostgreSQL 14 on the machine this was
# written on listens on 5433.
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=fund_diagrams

# The port the backend itself listens on.
PORT=3000
